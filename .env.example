# === MONGO ===
MONGO_PORT=27017          # Puerto por defecto de Mongo
MONGO_URL=                # ej: mongodb://localhost:27017/nombre_db

# === POSTGRES ===
POSTGRES_PORT=5432        # Puerto por defecto de Postgres
POSTGRES_DB=              # Nombre de la base de datos
POSTGRES_USER=            # Usuario de Postgres
POSTGRES_PASSWORD=        # Contraseña de Postgres
POSTGRES_URL=             # ej: postgresql://user:password@localhost:5432/db
POSTGRES_SHADOW_URL=      # Base de datos sombra que usa Prisma para migraciones
                          # ej: postgresql://user:password@localhost:5432/db_shadow

# === PGADMIN ===
PGADMIN_DEFAULT_EMAIL=    # Email para entrar a PgAdmin
PGADMIN_DEFAULT_PASSWORD= # Contraseña para entrar a PgAdmin

# === DATASET ===
DATASET_SEED=             # Semilla para datos aleatorios reproducibles (ej: 42)